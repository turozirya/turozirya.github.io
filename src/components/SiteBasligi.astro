---
// Üst çubuktaki site adını ~/Downloads/kod_turozirya-logo/site-logo-kodu.html'deki
// stilize logo metnine göre gösterir: "kod" (mono, kalın) + "_" (turuncu) + "turozirya",
// altında küçük "ROBOTİK KODLAMA" alt yazısı.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<img
				alt={config.logo.alt}
				src={logos.dark.src}
				width={logos.dark.width}
				height={logos.dark.height}
			/>
		)
	}
	<span class="kt-metin" translate="no">
		<span class="kt-ad"><span class="kt-kod">kod</span><span class="kt-cizgi">_</span>turozirya</span>
		<span class="kt-alt">ROBOTİK KODLAMA</span>
	</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}
	}

	.kt-metin {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		overflow: hidden;
		line-height: 1;
	}
	.kt-ad {
		font-family: 'Lexend', var(--sl-font-system, sans-serif);
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--sl-color-white, #ffffff);
	}
	.kt-kod,
	.kt-cizgi {
		font-family: 'JetBrains Mono', var(--sl-font-mono, monospace);
		font-weight: 800;
	}
	.kt-cizgi {
		color: #ff8a1f;
	}
	.kt-alt {
		font-size: 0.6rem;
		letter-spacing: 0.25em;
		font-weight: 600;
		color: var(--sl-color-gray-2, #e6dcfa);
	}

	@media (max-width: 50rem) {
		.kt-alt {
			display: none;
		}
	}
</style>
