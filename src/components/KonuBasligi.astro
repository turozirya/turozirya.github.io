---
// Starlight'ın sayfa başlığının altına konu bilgi kutusunu ekler.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { hafta, seviye, sure, kazanimlar, makecode, video } =
	Astro.locals.starlightRoute.entry.data;
const bilgiVar = hafta || seviye || sure || kazanimlar?.length || makecode || video;
---

<Default />

{
	bilgiVar && (
		<div class="konu-bilgi">
			<ul class="etiketler">
				{hafta && <li><strong>Hafta:</strong> {hafta}</li>}
				{seviye && <li><strong>Seviye:</strong> {seviye}</li>}
				{sure && <li><strong>Süre:</strong> {sure}</li>}
				{makecode && (
					<li>
						<a href={makecode} target="_blank" rel="noopener">MakeCode'da aç ↗</a>
					</li>
				)}
				{video && (
					<li>
						<a href={video} target="_blank" rel="noopener">Ders videosu ↗</a>
					</li>
				)}
			</ul>
			{kazanimlar?.length && (
				<div class="kazanimlar">
					<strong>Kazanımlar</strong>
					<ul>
						{kazanimlar.map((k) => (
							<li>{k}</li>
						))}
					</ul>
				</div>
			)}
		</div>
	)
}

<style>
	.konu-bilgi {
		margin-top: 1rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-left: 4px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		font-size: var(--sl-text-sm);
	}
	.etiketler {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.kazanimlar {
		margin-top: 0.6rem;
	}
	.kazanimlar ul {
		margin: 0.25rem 0 0;
		padding-left: 1.25rem;
	}
</style>
